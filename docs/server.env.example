# InsertAny3D Server machine configuration template.
# Copy to .insertany3d/runtime.env in the runtime checkout and keep that file private.

# These values must be existing absolute directories on the server.
HF_HOME=/path/to/cache/huggingface
TORCH_HOME=/path/to/cache/torch
MODELSCOPE_CACHE=/path/to/cache/modelscope

# Non-secret runtime defaults. Adjust the GPU index for the target machine.
CUDA_VISIBLE_DEVICES=0
PYTHONUNBUFFERED=1
TOKENIZERS_PARALLELISM=false
