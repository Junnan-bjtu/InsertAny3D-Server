# Python environments and generated bytecode
**/.venv/
**/__pycache__/
*.py[cod]
**/*.egg-info/
**/.cache/
/.build/

# Private machine configuration
/.insertany3d/
**/.env
**/.env.*
*.key
*.pem
*.secret

# Runtime data and logs
# The actual third-party checkouts are not copied into this publication tree.
# The named directories remain available as Git submodule gitlinks.
/third_party/*
!third_party/SAGS/
!third_party/gim/
!third_party/TRELLIS/
!third_party/Hunyuan3D-2/
!third_party/MVInpainter/
/Scenes/
/runs/
/debug_bundles/
/reproduction_outputs/
/rendered_from_unity/
/data/*
/metrics/HPSv2/
/metrics/checkpoints/
/model/
/source/
*.log
*.tmp
*.temp

# Local notebooks and generated archives
*.ipynb
*.zip
*.tar
!code/third_party/overlays/*.tar
